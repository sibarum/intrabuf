<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>sibarum.intrabuf</groupId>
    <artifactId>intrabuf</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Intrabuf</name>
    <description>
        Compile-time binary serialization for Java records. An annotation processor turns annotated records into
        straight-line encoders and decoders, so nothing reflects at runtime and everything survives native-image.
        Every payload carries just enough header to prove the reader and writer agree on the schema, and every
        build emits a manifest the CLI can use to turn a payload back into something a person can read.
    </description>

    <modules>
        <!-- The wire format: writer, reader, header, compatibility rules, the codec base class the generated code
             extends, and the schema model the processor and the CLI share. Also holds the annotations, which are
             CLASS-retained: readable by the processor across module boundaries, never loaded at runtime. -->
        <module>intrabuf-runtime</module>
        <!-- javac plugin: records in, codecs and a manifest out. Only ever on the annotation processor path. -->
        <module>intrabuf-processor</module>
        <!-- Manifest + payload in, human-readable text out. The native-image target. -->
        <module>intrabuf-cli</module>
        <!-- A small domain built the way a user would build one, plus a main that writes sample payloads. -->
        <module>intrabuf-example</module>
        <!-- Round-trip, compatibility, robustness and generated-vs-dynamic agreement tests. Depends on the example
             module so cross-module nesting (annotations read from a jar) is exercised. -->
        <module>intrabuf-tests</module>
    </modules>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.version>5.14.4</junit.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>sibarum.intrabuf</groupId>
                <artifactId>intrabuf-runtime</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>sibarum.intrabuf</groupId>
                <artifactId>intrabuf-processor</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>sibarum.intrabuf</groupId>
                <artifactId>intrabuf-cli</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>sibarum.intrabuf</groupId>
                <artifactId>intrabuf-example</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.15.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.4</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.5.0</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
