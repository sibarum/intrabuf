<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>sibarum.intrabuf</groupId>
        <artifactId>intrabuf</artifactId>
        <version>0.1.1</version>
    </parent>

    <artifactId>intrabuf-tests</artifactId>

    <name>intrabuf-tests</name>
    <description>
        End-to-end tests of generated codecs: round trips of every supported type, compatibility between versions
        of a schema (several versions of one schema are declared side by side under one schema name), garbage
        and truncation robustness, and agreement between the generated codecs and the manifest-driven decoder.
        Nests intrabuf-example's records to cover schemas read from another module's class files.
    </description>

    <properties>
        <!-- Tests only: nothing to package or publish. -->
        <maven.jar.skipIfEmpty>true</maven.jar.skipIfEmpty>
        <maven.install.skip>true</maven.install.skip>
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>sibarum.intrabuf</groupId>
            <artifactId>intrabuf-runtime</artifactId>
        </dependency>
        <dependency>
            <groupId>sibarum.intrabuf</groupId>
            <artifactId>intrabuf-example</artifactId>
        </dependency>
        <dependency>
            <groupId>sibarum.intrabuf</groupId>
            <artifactId>intrabuf-cli</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>sibarum.intrabuf</groupId>
                            <artifactId>intrabuf-processor</artifactId>
                            <version>${project.version}</version>
                        </path>
                    </annotationProcessorPaths>
                    <compilerArgs>
                        <!-- A release build: payloads carry no snapshot flag, so the version rules are what's tested. -->
                        <arg>-Aintrabuf.buildVersion=1.0.0</arg>
                        <arg>-Aintrabuf.module=${project.artifactId}</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
